# paykeeper runtime configuration (prefix: PAYKEEPER_)
#
# Minimum required: PAYKEEPER_WEBHOOK_SECRET. Everything else has defaults.

PAYKEEPER_ENVIRONMENT=dev
PAYKEEPER_LOG_LEVEL=INFO
PAYKEEPER_LOG_FORMAT=json

PAYKEEPER_DATABASE_URL=postgresql+asyncpg://paykeeper:paykeeper@localhost:5432/paykeeper

PAYKEEPER_WEBHOOK_SECRET=replace-me-with-a-long-random-string
PAYKEEPER_WEBHOOK_TOLERANCE_SECONDS=300

PAYKEEPER_PRIMARY_PROVIDER=fake
PAYKEEPER_SECONDARY_PROVIDER=fake

# Required only when PRIMARY_PROVIDER=stripe
# PAYKEEPER_STRIPE_API_KEY=sk_test_...
# PAYKEEPER_STRIPE_BASE_URL=https://api.stripe.com
# PAYKEEPER_STRIPE_TIMEOUT_SECONDS=10

PAYKEEPER_IDEMPOTENCY_LOCK_STALE_SECONDS=30
PAYKEEPER_IDEMPOTENCY_TTL_SECONDS=86400

PAYKEEPER_RETRY_MAX_ATTEMPTS=4
PAYKEEPER_RETRY_BASE_DELAY_MS=50
PAYKEEPER_RETRY_MAX_DELAY_MS=2000

PAYKEEPER_BREAKER_FAILURE_THRESHOLD=5
PAYKEEPER_BREAKER_WINDOW_SECONDS=60
PAYKEEPER_BREAKER_OPEN_SECONDS=30

PAYKEEPER_HTTP_PORT=8000
